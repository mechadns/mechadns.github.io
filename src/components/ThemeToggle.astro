<div id="theme-toggle" class="relative w-14 h-8 flex items-center bg-gray-300 dark:bg-gray-700 rounded-full cursor-pointer">
    <!-- Slider Knob -->
    <div id="toggle-knob" class="absolute left-1 w-6 h-6 bg-white dark:bg-black rounded-full shadow-md transition-transform duration-300"></div>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const toggle = document.getElementById('theme-toggle');
        const knob = document.getElementById('toggle-knob');

        const updateTheme = (isDark) => {
            if (isDark) {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                knob.style.transform = 'translateX(25px)'; 
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                knob.style.transform = 'translateX(0)'; 
            }
        };

        const currentTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        updateTheme(currentTheme === 'dark');

        toggle.addEventListener('click', () => {
            const isDark = !document.documentElement.classList.contains('dark');
            updateTheme(isDark);
        });
    });
</script>